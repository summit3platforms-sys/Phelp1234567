generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Brand {
  id          String    @id @default(uuid())
  name        String    @unique
  slug        String    @unique
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  articles    Article[]
}

model Category {
  id          String    @id @default(uuid())
  name        String    @unique
  slug        String    @unique
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  articles    Article[]
}

model Article {
  id                   String     @id @default(uuid())
  title                String
  slug                 String     @unique
  content              String
  featuredImage        String?
  errorCode            String?
  printerModel         String?
  tags                 String?
  seoTitle             String?
  metaDescription      String?
  status               String     @default("draft")
  brandId              String?
  categoryId           String?
  publishedAt          DateTime?
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt
  authorId             String?
  featuredImageAlt     String?
  featuredImageTitle   String?
  featuredImageCaption String?
  canonicalUrl         String?
  wordCount            Int?
  excerpt              String?
  featuredSnippet      String?
  faqs                 String?
  uploadedImages       String?
  difficultyLevel      String?    @default("Intermediate")
  reviewedAt           DateTime?
  reviewerId           String?
  timeToFix            String?    @default("15 minutes")
  author               Author?    @relation("ArticleAuthor", fields: [authorId], references: [id])
  brand                Brand?     @relation(fields: [brandId], references: [id])
  category             Category?  @relation(fields: [categoryId], references: [id])
  reviewer             Author?    @relation("ArticleReviewer", fields: [reviewerId], references: [id])
  revisions            Revision[]
}

model Revision {
  id                   String   @id @default(uuid())
  articleId            String
  version              Int
  title                String
  content              String
  seoTitle             String?
  metaDescription      String?
  faqs                 String?
  featuredImage        String?
  featuredImageAlt     String?
  featuredImageTitle   String?
  featuredImageCaption String?
  excerpt              String?
  featuredSnippet      String?
  createdAt            DateTime @default(now())
  uploadedImages       String?
  article              Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
}

model Redirect {
  id        String   @id @default(uuid())
  oldUrl    String   @unique
  newUrl    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id        String   @id @default(uuid())
  username  String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Lead {
  id               String   @id @default(uuid())
  name             String
  email            String
  phone            String
  printerBrand     String
  status           String   @default("new")
  createdAt        DateTime @default(now())
  country          String?
  ipAddress        String?
  issueDescription String?
}

model Author {
  id               String    @id @default(uuid())
  name             String
  slug             String    @unique
  bio              String?
  image            String?
  role             String?   @default("Technical Expert")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  experienceYears  Int?      @default(10)
  credentialsUrl   String?
  linkedinUrl      String?
  twitterUrl       String?
  articles         Article[] @relation("ArticleAuthor")
  reviewedArticles Article[] @relation("ArticleReviewer")
}
